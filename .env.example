# ---- Payment ----
# Which gateway adapter to use. Registered adapters: payping, mock
# Use `mock` to click through the whole flow locally with no bank / no tunnel.
PAYMENT_GATEWAY=mock
# MOCK_VERIFY=fail        # force the mock verify step to fail
# ALLOW_MOCK_PAYMENT=1    # required to use `mock` when NODE_ENV=production

# HMAC secret that seals pending orders during the bank round-trip.
# Generate one: `openssl rand -hex 32`
PAYMENT_SECRET=

# Absolute public origin of the site, used to build the gateway callback URL.
# Must be reachable by the gateway. In dev with a tunnel, put the tunnel URL here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- PayPing ----
# Access token from https://console.payping.io  (Developer > Tokens)
PAYPING_TOKEN=
# Override only for testing; defaults to https://api.payping.ir
# PAYPING_BASE_URL=https://api.payping.ir
